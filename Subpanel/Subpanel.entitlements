<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sandboxed by default — the safe modern baseline and a prerequisite for
	  the Mac App Store. This template reads no files and makes no network
	  calls, so it needs nothing more.

	  Add capabilities as your app grows, e.g.:
	    com.apple.security.network.client                       (outbound network)
	    com.apple.security.files.user-selected.read-write       (open/save panels)
	    com.apple.security.files.downloads.read-write           (~/Downloads)

	  If you must spawn helper processes / load unsigned code, you'll instead
	  turn the sandbox OFF and add hardened-runtime exceptions — but prefer
	  staying sandboxed.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  subpanel-service — registered by Subpanel.app via SMAppService.agent().

  A per-user LaunchAgent: the service runs as the logged-in user, never root.
  launchd (which is root) binds the two Sockets below and hands the listening
  descriptors to the service via launch_activate_socket(3). That is how an
  unprivileged process serves 127.0.0.1:80 — and why the sockets stay open
  (connections queue) while launchd restarts a crashed service.

  Loopback only: never 0.0.0.0. See plans/service-lifecycle.md.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.sockpuppet.subpanel.service</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/subpanel-service</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>org.sockpuppet.subpanel</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>HTTP4</key>
		<dict>
			<key>SockNodeName</key>
			<string>127.0.0.1</string>
			<key>SockServiceName</key>
			<string>80</string>
			<key>SockFamily</key>
			<string>IPv4</string>
		</dict>
		<key>HTTP6</key>
		<dict>
			<key>SockNodeName</key>
			<string>::1</string>
			<key>SockServiceName</key>
			<string>80</string>
			<key>SockFamily</key>
			<string>IPv6</string>
		</dict>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
